{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
  "import": [
    "css:config/ldp/handler/components/authorizer.json",
    "css:config/ldp/handler/components/lws-access.json",
    "css:config/ldp/handler/components/lws-error-handler.json",
    "css:config/ldp/handler/components/lws-notifications.json",
    "css:config/ldp/handler/components/solid-lws-storage-description.json",
    "css:config/ldp/handler/components/operation-handler.json",
    "css:config/ldp/handler/components/operation-metadata.json",
    "css:config/ldp/handler/components/preferences.json",
    "css:config/ldp/handler/components/request-parser.json",
    "css:config/ldp/handler/components/response-writer.json"
  ],
  "@graph": [
    {
      "comment": "The main entry point into the main Solid and LWS behaviour.",
      "@id": "urn:solid-server:default:LdpHandler",
      "@type": "ParsingHttpHandler",
      "args_requestParser": { "@id": "urn:solid-server:default:RequestParser" },
      "args_errorHandler": { "@id": "urn:solid-server:default:ErrorHandler" },
      "args_responseWriter": { "@id": "urn:solid-server:default:ResponseWriter" },
      "args_operationHandler": {
        "@type": "StatusWaterfallHandler",
        "handlers": [
          {
            "comment": "The storage description is public, so it is handled before authorization.",
            "@id": "urn:solid-server:default:LwsStorageDescriptionHandler"
          },
          {
            "comment": "Creates the LWS access grant and access request containers in storages that do not have them yet.",
            "@type": "AccessContainerInitializingHandler",
            "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" },
            "resourceSet": { "@id": "urn:solid-server:default:CachedResourceSet" },
            "store": { "@id": "urn:solid-server:default:ResourceStore" },
            "paths": [ ".lws/grants/", ".lws/requests/" ],
            "source": {
              "@type": "AuthorizingHttpHandler",
              "args_credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
              "args_modesExtractor": { "@id": "urn:solid-server:default:ModesExtractor" },
              "args_permissionReader": { "@id": "urn:solid-server:default:PermissionReader" },
              "args_authorizer": { "@id": "urn:solid-server:default:Authorizer" },
              "args_operationHandler": {
                "@type": "WacAllowHttpHandler",
                "args_credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
                "args_modesExtractor": { "@id": "urn:solid-server:default:ModesExtractor" },
                "args_permissionReader": { "@id": "urn:solid-server:default:PermissionReader" },
                "args_operationHandler": {
                  "comment": "LWS expects 204 instead of 205 responses after successful PUT, PATCH, and DELETE requests.",
                  "@type": "NoContentOperationHandler",
                  "source": {
                    "comment": "Validates the documents posted to the LWS access grant and access request containers.",
                    "@type": "AccessDocumentOperationHandler",
                    "source": {
                      "comment": "Supports recursive deletes of containers with the Depth header.",
                      "@type": "RecursiveDeleteOperationHandler",
                      "source": { "@id": "urn:solid-server:default:OperationHandler" },
                      "store": { "@id": "urn:solid-server:default:ResourceStore" }
                    },
                    "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" },
                    "grantPath": ".lws/grants/",
                    "requestPath": ".lws/requests/",
                    "reservedPath": ".lws/",
                    "sender": { "@id": "urn:solid-server:default:LwsNotificationSender" }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "comment": "Parses the page parameter of paginated LWS container listings.",
      "@id": "urn:solid-server:default:PreferenceParser",
      "@type": "UnionPreferenceParser",
      "parsers": [{ "@type": "LwsPagePreferenceParser" }]
    }
  ]
}
