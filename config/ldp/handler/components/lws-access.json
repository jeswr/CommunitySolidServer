{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": "Keeps track of the LWS access grants, which are stored in the access grant container of every storage.",
      "@id": "urn:solid-server:default:AccessGrantIndex",
      "@type": "AccessGrantIndex",
      "store": { "@id": "urn:solid-server:default:ResourceStore" },
      "emitter": { "@id": "urn:solid-server:default:ResourceStore" },
      "grantPath": ".lws/grants/"
    },
    {
      "comment": "Grants the permissions described by the LWS access grants.",
      "@id": "urn:solid-server:default:AccessGrantReader",
      "@type": "AccessGrantReader",
      "index": { "@id": "urn:solid-server:default:AccessGrantIndex" },
      "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" },
      "identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" },
      "store": { "@id": "urn:solid-server:default:ResourceStore" },
      "requestPath": ".lws/requests/"
    },
    {
      "comment": [
        "Combines the permissions of the access grants with those of the policy engine (WAC or ACP).",
        "Internal resources are handled by the PathBasedReader before reaching this point, so grants never apply to them."
      ],
      "@id": "urn:solid-server:default:ReadDeleteReaderLwsOverride",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ReadDeleteReader" },
      "overrideSteps": [{
        "@type": "OverrideParameters",
        "overrideValue": {
          "@type": "ReadDeleteReader",
          "reader": {
            "@id": "urn:solid-server:default:LwsUnionPermissionReader",
            "@type": "UnionPermissionReader",
            "readers": [
              { "@id": "urn:solid-server:default:PolicyEngineReader" },
              { "@id": "urn:solid-server:default:AccessGrantReader" }
            ]
          }
        }
      }]
    },
    {
      "comment": "Advertises the access request and access grant containers in the storage description.",
      "@id": "urn:solid-server:default:LwsStorageDescriptionHandler",
      "@type": "LwsStorageDescriptionHandler",
      "describers": [
        {
          "@type": "AccessServiceDescriber",
          "grantPath": ".lws/grants/",
          "requestPath": ".lws/requests/"
        }
      ]
    }
  ]
}
