{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": "Caches the credentials based on the incoming request.",
      "@id": "urn:solid-server:default:CredentialsExtractor",
      "@type": "CachedHandler",
      "source": {
        "comment": "Supports LWS access tokens, Solid-OIDC DPoP and Bearer access tokens, or no credentials.",
        "@id": "urn:solid-server:default:WaterfallCredentialsExtractor",
        "@type": "WaterfallHandler",
        "handlers": [
          {
            "comment": [
              "Handles Bearer tokens without a webid claim. Bearer tokens with a webid claim are Solid-OIDC tokens and are handled by the Solid extractors.",
              "Requests with an invalid LWS access token are rejected with a 401 response, as required by LWS."
            ],
            "@id": "urn:solid-server:default:LwsAccessTokenExtractor",
            "@type": "LwsAccessTokenExtractor",
            "issuer": { "@id": "urn:solid-server:default:LwsAccessTokenIssuer" },
            "targetExtractor": { "@id": "urn:solid-server:default:TargetExtractor" },
            "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" },
            "skipWebIdTokens": true
          },
          {
            "comment": "The default Solid-OIDC credentials extraction.",
            "@id": "urn:solid-server:default:UnionCredentialsExtractor",
            "@type": "UnionCredentialsExtractor",
            "extractors": [
              {
                "@id": "urn:solid-server:default:AccessTokenExtractor",
                "@type": "WaterfallHandler",
                "handlers": [
                  {
                    "@id": "urn:solid-server:default:DPoPWebIdExtractor",
                    "@type": "DPoPWebIdExtractor",
                    "originalUrlExtractor": {
                      "@id": "urn:solid-server:default:DPoPUrlExtractor",
                      "@type": "OriginalUrlExtractor",
                      "args_identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" }
                    }
                  },
                  {
                    "@id": "urn:solid-server:default:BearerWebIdExtractor",
                    "@type": "BearerWebIdExtractor"
                  }
                ]
              },
              {
                "@id": "urn:solid-server:default:PublicCredentialsExtractor",
                "@type": "PublicCredentialsExtractor"
              }
            ]
          }
        ]
      }
    }
  ]
}
